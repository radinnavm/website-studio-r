# Contact email delivery — server-side only.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Which email adapter to use: `console` (logs submissions, dev only) or `resend`.
EMAIL_PROVIDER=console

# `npm start` defaults to NODE_ENV=production and refuses to start without a
# real provider, so submissions are never silently logged as PII. Override to
# `development` only when running the production server locally.
# NODE_ENV=production

# Required in production and when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@websitestudior.bg
# CONTACT_FROM_EMAIL=Website Studio R <no-reply@websitestudior.bg>

# Trust `X-Forwarded-For` for client IP detection (rate limiting).
# Enable ONLY behind a reverse proxy you control — otherwise the header can be
# spoofed and the rate limit bypassed.
# TRUST_PROXY=1

# Optional — port for the production server (`npm start`)
# PORT=3000
