# Contact email delivery — server-side only.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Static hosting (client bundle, PUBLIC — never put a secret here) --------
# On a static host there is no Node server, so the contact form posts to an
# external form service instead of the in-process `/api/contact` route. Set
# VITE_CONTACT_ENDPOINT at build time (e.g. in the Render Dashboard) to the
# service's form URL. When unset, the form falls back to `/api/contact`, which
# works for `npm run dev` / `npm run preview`.
#   Formspree: https://formspree.io/f/<form-id>
#   Basin:     https://usebasin.com/f/<form-id>
#   Web3Forms: https://api.web3forms.com/submit  (+ VITE_CONTACT_ACCESS_KEY)
# VITE_CONTACT_ENDPOINT=
# VITE_CONTACT_ACCESS_KEY=

# Which email adapter to use: `console` (logs submissions, dev only) or `resend`.
# Only used by the Node server (`npm start`) / local Vite middleware.
EMAIL_PROVIDER=console

# `npm start` defaults to NODE_ENV=production and refuses to start without a
# real provider, so submissions are never silently logged as PII. Override to
# `development` only when running the production server locally.
# NODE_ENV=production

# Required in production and when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=hello@websitestudior.bg
# CONTACT_FROM_EMAIL=Website Studio R <no-reply@websitestudior.bg>

# Trust `X-Forwarded-For` for client IP detection (rate limiting).
# Enable ONLY behind a reverse proxy you control — otherwise the header can be
# spoofed and the rate limit bypassed.
# TRUST_PROXY=1

# Optional — port for the production server (`npm start`)
# PORT=3000
